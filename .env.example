# StemForge Studio - environment variables
# Copy this file to .env (local dev) and configure the same keys in
# Netlify's Site Settings > Environment Variables for deploys.
#
# NONE of these are ever exposed to the frontend - they are only read
# inside netlify/functions and netlify/background, which run server-side.

# --- Stem separation (Demucs-compatible inference service) ---
# Example: a Replicate deployment, a self-hosted Demucs API, etc.
SEPARATION_API_URL=
SEPARATION_API_KEY=

# --- Drum transcription model (optional) ---
# If unset, the app falls back to the local heuristic onset/spectral
# classifier (providers/DrumTranscription/HeuristicDrumProvider.ts).
DRUM_MODEL_API_URL=
DRUM_MODEL_API_KEY=

# --- Temporary storage (optional, for larger files / background jobs) ---
# S3-compatible endpoint used to stage uploads for the background function.
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=
